            <X className="h-3.5 w-3.5" />
          </button>
        </div>

        {/* Cuerpo Plano (CON RENDERIZADO CONDICIONAL) */}
        <div className="purchase-body flex flex-col items-center justify-center text-center py-6">
          
          {pagoAnexado ? (

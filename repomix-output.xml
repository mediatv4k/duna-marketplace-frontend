  onViewTracking: () => void;
  onViewReceipt: () => void;
  storeName?: string;
  pagoAnexado?: boolean; // LA LLAVE MÁGICA: Define qué cara de la ventana se muestra
}

export default function OrderSuccessModal({ 
  isOpen, 
  onClose, 
  onViewTracking, 
  onViewReceipt,
  storeName = "Papá Helado",

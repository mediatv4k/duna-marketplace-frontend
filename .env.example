# ==============================================================================
# D'una Marketplace - plantilla de variables de entorno
#
# Uso: copia este archivo como .env.local y completa los valores.
#   - .env.local NO se sube a git (.gitignore). Este archivo SI: no pongas claves reales aqui.
#   - Las variables NEXT_PUBLIC_* se incrustan en el bundle del navegador al compilar:
#     son publicas por diseno (nunca guardes en ellas un secreto privado) y, tras cambiarlas,
#     hay que reiniciar `next dev` o volver a compilar.
#   - Una variable vacia equivale a no definirla (el codigo usa su valor de respaldo, si lo tiene).
#   - En el hosting (Vercel) se cargan en el panel del proyecto, no desde este archivo.
# ==============================================================================

# --- Backend AdonisJS (catalogo, pedidos, tarifas) -----------------------------
# Se leen en src/services/marketplaceService.ts. Si faltan, el codigo usa valores de
# respaldo que apuntan al backend DEV.
NEXT_PUBLIC_API_URL=https://dev.carjos-marketplace.cloud
# API key publica del backend (viaja en el header `apiKey`).
NEXT_PUBLIC_SERVER_API_KEY=
# Zona horaria que viaja en el header `timeZone`.
NEXT_PUBLIC_TIMEZONE=America/Caracas

# --- Google Maps (selector de direccion y mapa de seguimiento) -----------------
# Se lee en src/lib/googleMaps.ts. Clave de navegador: restringela por dominio (HTTP
# referrer) en Google Cloud. APIs necesarias: Maps JavaScript y Geocoding (Places es opcional).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Firebase base: Firestore (salas de "Pedido entre panas") ------------------
# Se leen en src/lib/firebaseConfig.ts y las usa /api/combo/[id].
# OBLIGATORIAS para las salas: NO tienen valor de respaldo. Sin ellas /api/combo/{id}
# responde 500 ("Error al consultar la sala" / "Error al crear la sala").
# Valores: consola de Firebase > Configuracion del proyecto > Tus apps > App web.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Formato: <proyecto>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Formato: <proyecto>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cuentas de cliente (Firebase Authentication) ------------------------------
# Comprar NO exige cuenta. `false` oculta el inicio de sesion aunque Firebase este
# configurado; cualquier otro valor (o no definirla) lo deja visible.
NEXT_PUBLIC_AUTH_ENABLED=true
# OPCIONAL: proyecto de Firebase solo para Authentication (asi las cuentas viven aparte de
# Firestore). API_KEY, AUTH_DOMAIN y PROJECT_ID deben ir las tres juntas; si no se definen,
# Authentication usa el proyecto base de arriba.
NEXT_PUBLIC_AUTH_FIREBASE_API_KEY=
NEXT_PUBLIC_AUTH_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_AUTH_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_AUTH_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_AUTH_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_AUTH_FIREBASE_APP_ID=
NEXT_PUBLIC_AUTH_FIREBASE_MEASUREMENT_ID=
# OPCIONAL: Web client ID del proveedor Google de Firebase (boton oficial de 1 clic).
# Sin el se usa la ventana emergente de Firebase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# SOLO pruebas locales con el emulador de Firebase Auth. No definir en produccion.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Landing de D'una Delivery (enlace de la cabecera del Home) ----------------
# Se lee en src/components/MarketplaceHub.tsx. URL completa, con http:// o https://.
# Sin esta variable el enlace NO se dibuja (no hay valor de respaldo).
# El valor de abajo es el del entorno local de desarrollo: una IP de la red local solo
# abre dentro de esa red. En produccion debe ser la URL publica de la landing.
NEXT_PUBLIC_DELIVERY_LANDING_URL=http://192.168.9.122:3000

# --- Asistente de ventas con Gemini (SOLO servidor) ----------------------------
# Sin prefijo NEXT_PUBLIC_: esta clave SI es secreta y nunca llega al navegador.
# Se lee en src/app/api/assistant/route.ts. Sin ella /api/assistant responde 503
# ("Asistente no configurado").
GEMINI_API_KEY=
# OPCIONAL: modelo de Gemini. Sin definir se usa el que trae por defecto route.ts.
# GEMINI_MODEL=
